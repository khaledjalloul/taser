<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="taser">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import taser urdf file -->
    <xacro:include filename="$(find taser_ros)/config/taser.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="taser.ros2_control.xacro" />


    <xacro:taser_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
