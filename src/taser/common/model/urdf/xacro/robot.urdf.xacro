<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="taser">

    <xacro:include filename="./base.xacro" />
    <xacro:include filename="./arm.xacro" />
    <xacro:include filename="./wheel.xacro" />
    <xacro:include filename="./ros2_control.xacro" />

    <xacro:taser_ros2_control />

    <xacro:base />
    <xacro:lock side="front" offset_sign="+" />
    <xacro:lock side="back" offset_sign="-" />

    <xacro:arm side="left" offset_sign="+" />
    <xacro:arm side="right" offset_sign="-" />

    <xacro:wheel side="left" offset_sign="+" />
    <xacro:wheel side="right" offset_sign="-" />

</robot>