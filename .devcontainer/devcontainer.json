{
    "name": "TASER",
    "dockerComposeFile": [
        "../docker/compose.yaml",
        "./compose.yaml"
    ],
    "service": "taser",
    "workspaceFolder": "/workspace/taser",
    "customizations": {
        "vscode": {
            "extensions": [
                // Python
                "ms-python.python",
                "charliermarsh.ruff",
                "ms-python.vscode-pylance",
                "tamasfe.even-better-toml",
                // C++
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "kylinideteam.cmake-intellisence",
                "xaver.clang-format",
                // ROS
                "morningfrog.urdf-visualizer",
                // Isaac Sim
                "nvidia.isaacsim-vscode-edition",
                // Yaml
                "redhat.vscode-yaml",
                // XML
                "redhat.vscode-xml",
                // Markdown
                "yzhang.markdown-all-in-one",
                // Docker
                "ms-azuretools.vscode-docker",
                // GitLens
                "eamodio.gitlens",
                // Shell Formatter
                "mkhl.shfmt"
            ],
            "settings": {
                "gitlens.codeLens.authors.enabled": false,
                "gitlens.codeLens.recentChange.enabled": false,
                "python.defaultInterpreterPath": "/isaac-sim/kit/python/python3",
                "C_Cpp.default.includePath": [
                    "${workspaceFolder}/**",
                    "/opt/ros/jazzy/include/**",
                    "/opt/ros/humble/include/**"
                ]
            }
        }
    }
}